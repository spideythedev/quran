{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "src-tauri": {
      "root": "tauri-app/src-tauri",
      "runtime": "rust"
    },
    "web": {
      "root": "web",
      "framework": "flask"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}